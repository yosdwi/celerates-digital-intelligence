# Local demonstration defaults only. Never reuse these values in a shared environment.
DATABASE_URL=postgresql://celerates:celerates@postgres:5432/celerates
POSTGRES_USER=celerates
POSTGRES_PASSWORD=celerates
POSTGRES_DB=celerates
STORAGE_BACKEND=s3
STORAGE_PATH=.data/objects
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=celerates
S3_SECRET_KEY=celerates-local-only
S3_BUCKET=intelligence
ERP_MODE=demo
ERP_BASE_URL=
ERP_TOKEN=
MODEL_MODE=demo
REASONING_MODEL=openai/reasoning-strong
FALLBACK_MODEL=
EMBEDDING_MODEL=openai/embedding-default
# Set for an OpenAI-compatible LiteLLM endpoint; omit for direct SDK provider routing.
MODEL_API_BASE=
MODEL_API_KEY=
# Required in HTTP ERP mode. Local demo can leave blank. Enter in web reviewer access dialog.
API_ACCESS_TOKEN=
# ADR-008: ERP delegation public keys for the embedded Agent, JSON {kid: PEM}. Generate with
# node scripts/generate-agent-delegation-key.mjs; the private key belongs to the ERP service only.
ERP_DELEGATION_PUBLIC_KEYS={}
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
N8N_ENABLED=false
WORKER_POLL_SECONDS=1
LEASE_SECONDS=600
