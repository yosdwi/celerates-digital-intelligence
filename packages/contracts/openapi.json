  "components": {
    "schemas": {
      "ArtifactContent": {
        "properties": {
          "summary": {
            "type": "string",
            "maxLength": 20000,
            "title": "Summary"
          },
          "rows": {
            "items": {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            "type": "array",
            "maxItems": 200,
            "title": "Rows"
          }
        },
        "type": "object",
        "required": [
          "summary",
          "rows"
        ],
        "title": "ArtifactContent"
      },
      "ArtifactEdit": {
        "properties": {
          "version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Version"
          },
          "content": {
            "$ref": "#/components/schemas/ArtifactContent"
          }
        },
        "type": "object",
        "required": [
          "version",
          "content"
        ],
        "title": "ArtifactEdit"
      },
      "Body_upload_document_api_opportunities__oid__upload_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_document_api_opportunities__oid__upload_post"
      },
      "ContextQuery": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 3,
            "title": "Question"
          }
        },
        "type": "object",
        "required": [
          "question"
        ],
        "title": "ContextQuery"
      },
      "Decision": {
        "properties": {
          "outcome": {
            "type": "string",
            "enum": [
              "READY_FOR_SALES",
              "CLARIFICATION_REQUIRED"
            ],
            "title": "Outcome"
          },
          "note": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 5,
            "title": "Note"
          }
        },
        "type": "object",
        "required": [
          "outcome",
          "note"
        ],
        "title": "Decision"
      },
      "DocumentRegister": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Name"
          },
          "text": {
            "type": "string",
            "maxLength": 500000,
            "minLength": 20,
            "title": "Text"
          },
          "source_url": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1500
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Url"
          }
        },
        "type": "object",
        "required": [
          "name",
          "text"
        ],
        "title": "DocumentRegister"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "OpportunityCreate": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 180,
            "minLength": 3,
            "title": "Title"
          },
          "customer": {
            "type": "string",
            "maxLength": 140,
            "minLength": 2,
            "title": "Customer"
          },
          "owner": {
            "type": "string",
            "maxLength": 100,
            "minLength": 2,
            "title": "Owner"
          },
          "timeline": {
            "type": "string",
            "maxLength": 160,
            "title": "Timeline",
            "default": ""
          },
          "notes": {
            "type": "string",
            "maxLength": 5000,
            "title": "Notes",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "title",
          "customer",
          "owner"
        ],
        "title": "OpportunityCreate"
      },
      "ReviewPack": {
        "properties": {
          "versions": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Versions"
          },
          "note": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 5,
            "title": "Note"
          }
        },
        "type": "object",
        "required": [
          "versions",
          "note"
        ],
        "title": "ReviewPack"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
