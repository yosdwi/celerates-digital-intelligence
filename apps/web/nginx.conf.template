server {
    listen ${PORT};
    root /usr/share/nginx/html;
    index index.html;
    # Resolve again after API replacement; static startup DNS can retain a drained IP.
    resolver ${CDI_DNS_RESOLVERS} valid=5s;
    resolver_timeout 5s;
    set $cdi_api "${API_UPSTREAM}";
    proxy_connect_timeout 5s;
    client_max_body_size 11m;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    location /api/ {
        proxy_pass $cdi_api$request_uri;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 120s;
    }
    location /health { proxy_pass $cdi_api$request_uri; }
    location /ready { proxy_pass $cdi_api$request_uri; }
    location / { try_files $uri $uri/ /index.html; }
}
